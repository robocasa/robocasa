+import json
+
+import pytest
+
+from gear_sonic.utils.data_collection.episode_instruction_subscriber import (
+    EPISODE_INSTRUCTION_MESSAGE_TYPE,
+    EPISODE_INSTRUCTION_PROTOCOL_VERSION,
+    EpisodeStartGate,
+    EpisodeTaskPromptState,
+    decode_episode_instruction_message,
+    resolve_recording_command,
+)
+
+
+def _message(
+    episode_id: str,
+    sequence: int,
+    instruction: str | None,
+    *,
+    event: str = "ready",
+    attempt: int = 0,
+):
+    return json.dumps(
+        {
+            "type": EPISODE_INSTRUCTION_MESSAGE_TYPE,
+            "version": EPISODE_INSTRUCTION_PROTOCOL_VERSION,
+            "episode_id": episode_id,
+            "sequence": sequence,
+            "event": event,
+            "attempt": attempt,
+            "instruction": instruction,
+            "captured_at": 1.0,
+            "sent_at": 2.0,
+        }
+    )
+
+
+def test_decode_episode_instruction_message():
+    message = decode_episode_instruction_message(
+        _message("session:000001", 1, "  Pick up the cup and bowl.  ")
+    )
+
+    assert message.episode_id == "session:000001"
+    assert message.sequence == 1
+    assert message.event == "ready"
+    assert message.attempt == 0
+    assert message.instruction == "Pick up the cup and bowl."
+    assert message.episode_identity == ("session:000001", 1)
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "not-json",
+        "[]",
+        json.dumps({"type": "wrong", "version": 1}),
+        _message("session", -1, "task"),
+        _message("session", 0, 123),
+        _message("session", 0, "task", event="start", attempt=0),
+        _message("session", 0, "task", event="ready", attempt=1),
+    ],
+)
+def test_decode_episode_instruction_rejects_invalid_messages(raw):
+    with pytest.raises((TypeError, ValueError, json.JSONDecodeError)):
+        decode_episode_instruction_message(raw)
+
+
+def test_task_prompt_is_locked_per_episode_and_new_prompt_is_deferred():
+    state = EpisodeTaskPromptState("CLI fallback")
+    ready_a = decode_episode_instruction_message(_message("session:000000", 0, "Task A"))
+    episode_a = decode_episode_instruction_message(
+        _message("session:000000", 0, "Task A", event="start", attempt=1)
+    )
+    ready_b = decode_episode_instruction_message(_message("session:000001", 1, "Task B"))
+    episode_b = decode_episode_instruction_message(
+        _message("session:000001", 1, "Task B", event="start", attempt=1)
+    )
+
+    assert state.observe(ready_a)
+    assert not state.has_pending_start
+    assert state.observe(episode_a)
+    assert state.activate_start() == ("Task A", episode_a)
+    assert state.active_prompt == "Task A"
+    assert not state.observe(episode_a)
+
+    assert state.observe(ready_b)
+    assert state.observe(episode_b)
+    assert state.active_prompt == "Task A"
+    assert state.activate_start() == ("Task B", episode_b)
+    assert state.active_prompt == "Task B"
+
+    assert state.activate_fallback() == ("CLI fallback", None)
+    assert not state.observe(episode_b)
+
+
+def test_new_start_attempt_can_retry_the_same_episode():
+    state = EpisodeTaskPromptState("CLI fallback")
+    ready_a = decode_episode_instruction_message(_message("session:000000", 0, "Task A"))
+    start_a = decode_episode_instruction_message(
+        _message("session:000000", 0, "Task A", event="start", attempt=1)
+    )
+    retry_a = decode_episode_instruction_message(
+        _message("session:000000", 0, "Task A", event="start", attempt=2)
+    )
+
+    assert state.observe(ready_a)
+    assert state.observe(start_a)
+    assert state.activate_start() == ("Task A", start_a)
+    assert state.observe(retry_a)
+    assert state.activate_start() == ("Task A", retry_a)
+
+
+def test_missing_live_instruction_uses_cli_fallback():
+    state = EpisodeTaskPromptState("CLI fallback")
+    no_instruction = decode_episode_instruction_message(
+        _message("session:000002", 2, None, event="start", attempt=1)
+    )
+
+    assert state.observe(no_instruction)
+    assert state.activate_start() == ("CLI fallback", no_instruction)
+
+
+def test_start_gate_waits_for_live_start_metadata_without_fallback():
+    state = EpisodeTaskPromptState("CLI fallback")
+    gate = EpisodeStartGate(fallback_timeout=1.0)
+    ready = decode_episode_instruction_message(_message("session:000000", 0, "Task A"))
+    start = decode_episode_instruction_message(
+        _message("session:000000", 0, "Task A", event="start", attempt=1)
+    )
+
+    state.observe(ready)
+    gate.request(now=0.0)
+    assert gate.decision(state, now=2.0) is None
+    state.observe(start)
+    assert gate.decision(state, now=2.1) == "live"
+
+
+def test_start_gate_falls_back_only_for_legacy_collector():
+    state = EpisodeTaskPromptState("CLI fallback")
+    gate = EpisodeStartGate(fallback_timeout=1.0)
+
+    gate.request(now=10.0)
+    assert gate.decision(state, now=10.9) is None
+    assert gate.decision(state, now=11.0) == "fallback"
+
+
+def test_new_ready_drops_unmatched_start_from_previous_episode():
+    state = EpisodeTaskPromptState("CLI fallback")
+    gate = EpisodeStartGate(fallback_timeout=1.0)
+    start_a = decode_episode_instruction_message(
+        _message("session:000000", 0, "Task A", event="start", attempt=1)
+    )
+    ready_b = decode_episode_instruction_message(
+        _message("session:000001", 1, "Task B")
+    )
+    start_b = decode_episode_instruction_message(
+        _message("session:000001", 1, "Task B", event="start", attempt=1)
+    )
+
+    assert state.observe(start_a)
+    assert state.has_pending_start
+    assert state.observe(ready_b)
+    assert not state.has_pending_start
+    gate.request(now=0.0)
+    assert gate.decision(state, now=2.0) is None
+    assert state.observe(start_b)
+    assert gate.decision(state, now=2.1) == "live"
+    assert state.activate_start() == ("Task B", start_b)
+
+
+def test_new_start_advances_episode_when_conflate_drops_ready():
+    state = EpisodeTaskPromptState("CLI fallback")
+    gate = EpisodeStartGate(fallback_timeout=1.0)
+    ready_a = decode_episode_instruction_message(
+        _message("session:000000", 0, "Task A")
+    )
+    start_a = decode_episode_instruction_message(
+        _message("session:000000", 0, "Task A", event="start", attempt=1)
+    )
+    start_b = decode_episode_instruction_message(
+        _message("session:000001", 1, "Task B", event="start", attempt=1)
+    )
+
+    assert state.observe(ready_a)
+    assert state.observe(start_a)
+    assert state.activate_start() == ("Task A", start_a)
+    gate.request(now=0.0)
+    assert state.observe(start_b)
+    assert gate.decision(state, now=0.1) == "live"
+    assert state.activate_start() == ("Task B", start_b)
+
+
+def test_recording_command_priority_is_abort_then_toggle():
+    assert resolve_recording_command(
+        "c", manager_toggle=False, manager_abort=True
+    ) == "x"
+    assert resolve_recording_command(
+        "x", manager_toggle=True, manager_abort=False
+    ) == "x"
+    assert resolve_recording_command(
+        None, manager_toggle=True, manager_abort=False
+    ) == "c"
