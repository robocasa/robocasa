diff --git a/gear_sonic/utils/data_collection/episode_instruction_subscriber.py b/gear_sonic/utils/data_collection/episode_instruction_subscriber.py
new file mode 100644
--- /dev/null
+++ b/gear_sonic/utils/data_collection/episode_instruction_subscriber.py
@@ -0,0 +1,246 @@
+"""RoboCasa per-episode instruction metadata over ZMQ."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import json
+
+import zmq
+
+
+DEFAULT_EPISODE_INSTRUCTION_PORT = 5581
+EPISODE_INSTRUCTION_MESSAGE_TYPE = "robocasa_episode_instruction"
+EPISODE_INSTRUCTION_PROTOCOL_VERSION = 1
+
+
+def resolve_recording_command(
+    key: str | None,
+    *,
+    manager_toggle: bool,
+    manager_abort: bool,
+) -> str | None:
+    """Merge local and VR controls with deterministic abort-first priority."""
+    if manager_abort or key == "x":
+        return "x"
+    if manager_toggle or key == "c":
+        return "c"
+    return key
+
+
+@dataclass(frozen=True)
+class EpisodeInstructionMessage:
+    """Validated instruction snapshot for one sampled RoboCasa episode."""
+
+    episode_id: str
+    sequence: int
+    event: str
+    attempt: int
+    instruction: str | None
+    captured_at: float
+    sent_at: float
+
+    @property
+    def identity(self) -> tuple[str, int, str, int]:
+        return self.episode_id, self.sequence, self.event, self.attempt
+
+    @property
+    def episode_identity(self) -> tuple[str, int]:
+        return self.episode_id, self.sequence
+
+
+def decode_episode_instruction_message(raw: bytes | str) -> EpisodeInstructionMessage:
+    """Decode and validate the versioned RoboCasa instruction message."""
+    if isinstance(raw, bytes):
+        raw = raw.decode("utf-8")
+    if not isinstance(raw, str):
+        raise TypeError("episode instruction message must be bytes or str")
+
+    payload = json.loads(raw)
+    if not isinstance(payload, dict):
+        raise ValueError("episode instruction payload must be a JSON object")
+    if payload.get("type") != EPISODE_INSTRUCTION_MESSAGE_TYPE:
+        raise ValueError("unexpected episode instruction message type")
+    if payload.get("version") != EPISODE_INSTRUCTION_PROTOCOL_VERSION:
+        raise ValueError("unsupported episode instruction protocol version")
+
+    episode_id = payload.get("episode_id")
+    sequence = payload.get("sequence")
+    event = payload.get("event")
+    attempt = payload.get("attempt")
+    instruction = payload.get("instruction")
+    if not isinstance(episode_id, str) or not episode_id.strip():
+        raise ValueError("episode_id must be a non-empty string")
+    if isinstance(sequence, bool) or not isinstance(sequence, int) or sequence < 0:
+        raise ValueError("sequence must be a non-negative integer")
+    if event not in {"ready", "start"}:
+        raise ValueError("event must be 'ready' or 'start'")
+    if isinstance(attempt, bool) or not isinstance(attempt, int) or attempt < 0:
+        raise ValueError("attempt must be a non-negative integer")
+    if event == "ready" and attempt != 0:
+        raise ValueError("ready messages must use attempt 0")
+    if event == "start" and attempt == 0:
+        raise ValueError("start messages must use a positive attempt")
+    if instruction is not None:
+        if not isinstance(instruction, str):
+            raise ValueError("instruction must be a string or null")
+        instruction = instruction.strip() or None
+
+    try:
+        captured_at = float(payload["captured_at"])
+        sent_at = float(payload["sent_at"])
+    except (KeyError, TypeError, ValueError) as exc:
+        raise ValueError("captured_at and sent_at must be numeric") from exc
+
+    return EpisodeInstructionMessage(
+        episode_id=episode_id.strip(),
+        sequence=sequence,
+        event=event,
+        attempt=attempt,
+        instruction=instruction,
+        captured_at=captured_at,
+        sent_at=sent_at,
+    )
+
+
+class EpisodeTaskPromptState:
+    """Lock a task prompt for an episode and queue newer metadata for the next."""
+
+    def __init__(self, fallback_prompt: str):
+        if not isinstance(fallback_prompt, str):
+            raise TypeError("fallback_prompt must be a string")
+        fallback_prompt = fallback_prompt.strip()
+        self.fallback_prompt = fallback_prompt
+        self.active_prompt = fallback_prompt
+        self.active_message: EpisodeInstructionMessage | None = None
+        self.latest_message: EpisodeInstructionMessage | None = None
+        self.pending_start: EpisodeInstructionMessage | None = None
+        self._current_episode_identity: tuple[str, int] | None = None
+        self._consumed_start_identities: set[tuple[str, int, str, int]] = set()
+
+    @property
+    def has_live_metadata(self) -> bool:
+        return self.latest_message is not None
+
+    @property
+    def has_pending_start(self) -> bool:
+        return self.pending_start is not None
+
+    def observe(self, message: EpisodeInstructionMessage) -> bool:
+        if self.latest_message is not None and message.identity == self.latest_message.identity:
+            return False
+        if message.event == "ready":
+            self.latest_message = message
+            if message.episode_identity != self._current_episode_identity:
+                self._current_episode_identity = message.episode_identity
+                if (
+                    self.pending_start is not None
+                    and self.pending_start.episode_identity != message.episode_identity
+                ):
+                    self.pending_start = None
+            return True
+        if message.episode_identity != self._current_episode_identity:
+            # CONFLATE may replace a short-lived ready message with this full
+            # start state. A start is self-contained, so it can safely advance
+            # the current episode and clear any unmatched older attempt.
+            self._current_episode_identity = message.episode_identity
+            self.pending_start = None
+        self.latest_message = message
+        if message.identity in self._consumed_start_identities:
+            return False
+        self.pending_start = message
+        return True
+
+    def activate_start(self) -> tuple[str, EpisodeInstructionMessage]:
+        message = self.pending_start
+        if message is None:
+            raise RuntimeError("no pending RoboCasa start metadata")
+        self.pending_start = None
+        self.active_prompt = message.instruction or self.fallback_prompt
+        self.active_message = message
+        self._consumed_start_identities.add(message.identity)
+        return self.active_prompt, message
+
+    def activate_fallback(self) -> tuple[str, None]:
+        self.active_prompt = self.fallback_prompt
+        self.active_message = None
+        return self.active_prompt, None
+
+
+class EpisodeStartGate:
+    """Wait for start metadata, but preserve fallback for a legacy collector."""
+
+    def __init__(self, fallback_timeout: float = 1.0):
+        if fallback_timeout < 0:
+            raise ValueError("fallback_timeout must be non-negative")
+        self.fallback_timeout = float(fallback_timeout)
+        self.waiting_since: float | None = None
+
+    @property
+    def waiting(self) -> bool:
+        return self.waiting_since is not None
+
+    def request(self, now: float) -> None:
+        if not self.waiting:
+            self.waiting_since = float(now)
+
+    def cancel(self) -> None:
+        self.waiting_since = None
+
+    def decision(self, prompt_state: EpisodeTaskPromptState, now: float) -> str | None:
+        if not self.waiting:
+            return None
+        if prompt_state.has_pending_start:
+            self.cancel()
+            return "live"
+        # Once a versioned message has arrived, do not silently pair a live
+        # RoboCasa episode with the CLI fallback. The repeated start heartbeat
+        # will release this gate when the matching attempt arrives.
+        if prompt_state.has_live_metadata:
+            return None
+        assert self.waiting_since is not None
+        if float(now) - self.waiting_since >= self.fallback_timeout:
+            self.cancel()
+            return "fallback"
+        return None
+
+
+class ZMQEpisodeInstructionSubscriber:
+    """Receive the latest repeated RoboCasa episode-instruction state."""
+
+    def __init__(
+        self,
+        port: int = DEFAULT_EPISODE_INSTRUCTION_PORT,
+        host: str = "localhost",
+    ):
+        self._ctx = zmq.Context()
+        self._socket = self._ctx.socket(zmq.SUB)
+        self._socket.setsockopt_string(zmq.SUBSCRIBE, "")
+        self._socket.setsockopt(zmq.CONFLATE, 1)
+        self._socket.setsockopt(zmq.RCVTIMEO, 0)
+        self._socket.connect(f"tcp://{host}:{port}")
+        self._closed = False
+        print(f"[EpisodeInstruction] Connected to tcp://{host}:{port}")
+
+    def read_latest(self) -> EpisodeInstructionMessage | None:
+        try:
+            raw = self._socket.recv(zmq.NOBLOCK)
+        except zmq.Again:
+            return None
+        try:
+            return decode_episode_instruction_message(raw)
+        except (TypeError, UnicodeDecodeError, ValueError) as exc:
+            print(f"[EpisodeInstruction] Ignoring invalid message: {exc}")
+            return None
+
+    def close(self):
+        if self._closed:
+            return
+        self._closed = True
+        self._socket.close()
+        self._ctx.term()
+
+    def __del__(self):
+        try:
+            self.close()
+        except Exception:
+            pass
